# Agent and editor state. None of this belongs in a public repository, and
# CLAUDE.md in particular carries private operating instructions.
.claude/
CLAUDE.md
AGENTS.md
.cursor/
.aider*
.vscode/
.idea/

# Internal planning. Strategy notes live outside the repo on purpose: a plan
# that describes how to satisfy another maintainer's acceptance bar does not
# belong in the artifact submitted to that maintainer.
docs/REFACTOR-PLAN.md
docs/*-plan.md
docs/internal/

# OS and language noise
.DS_Store
__pycache__/
*.pyc
.venv/
.pytest_cache/
.coverage
coverage.json

# Audit output. Running the Slop Audit or Umbra against this repository drops
# reports here. They are a snapshot of one run on one machine, they go stale
# the moment the code changes, and a stale grade checked into a repository is
# worse than no grade. Run the tools; do not commit what they print.
umbra-report.*
slop-report*
audit-report*
.slop-audit/
